{
  "name": "parsedbf",
  "version": "2.0.0",
  "description": "The DBF parsing component of shapefile-js",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "mocha -R spec test/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/calvinmetcalf/parseDBF.git"
  },
  "keywords": [
    "dbf",
    "shp"
  ],
  "author": "Calvin Metcalf",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/calvinmetcalf/parseDBF/issues"
  },
  "ava": {
    "extensions": {
      "ts": "module"
    },
    "nodeArguments": [
      "--import=tsimp"
    ],
    "exclude": [
      "test/data"
    ]
  },
  "devDependencies": {
    "@sindresorhus/tsconfig": "^7.0.0",
    "@types/node": "^22.13.7",
    "ava": "^6.2.0",
    "tsimp": "^2.0.12",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "peek-readable": "^6.1.1"
  }
}
