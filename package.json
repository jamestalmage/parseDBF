{
  "name": "@jamestalmage/parsedbf",
  "version": "2.0.0",
  "description": "The DBF parsing component of shapefile-js",
  "main": "distribution/parse-dbf-either.js",
  "exports": {
    ".": {
      "types": "./distribution/index.d.ts",
      "default": "./distribution/index.js",
      "browser": "./distribution/parse-dbf-browser.js"
    },
    "./browser": {
      "types": "./distribution/parse-dbf-browser.d.ts",
      "default": "./distribution/parse-dbf-browser.js"
    },
    "./node": {
      "types": "./distribution/parse-dbf-node.d.ts",
      "default": "./distribution/parse-dbf-node.js"
    }
  },
  "type": "module",
  "scripts": {
    "prepublish": "npm run build",
    "build": "tsc",
    "test": "xo && npm run test-only",
    "test-only": "npm run test-node && npm run test-browser",
    "test-node": "mocha",
    "test-browser": "web-test-runner"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/jamestalamge/parseDBF.git"
  },
  "keywords": [
    "dbf",
    "shp"
  ],
  "author": "Calvin Metcalf",
  "license": "MIT",
  "contributors": [
    {
      "name": "James Talamge",
      "email": "james@talmage.io",
      "url": "github.com/jamestalmage"
    }
  ],
  "bugs": {
    "url": "https://github.com/jamestalamge/parseDBF/issues"
  },
  "ava": {
    "files": [
      "test/**/*",
      "!test/data/**"
    ]
  },
  "xo": {
    "envs": [
      "node",
      "browser"
    ],
    "ignores": [
      "test/data",
      "distribution"
    ]
  },
  "devDependencies": {
    "@sindresorhus/tsconfig": "^7.0.0",
    "@types/chai": "^5.2.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.7",
    "@web/dev-server-esbuild": "^1.0.4",
    "@web/test-runner": "^0.20.0",
    "@web/test-runner-playwright": "^0.11.0",
    "chai": "^5.2.0",
    "mocha": "^11.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "xo": "^0.60.0"
  },
  "dependencies": {
    "peek-readable": "^6.1.1"
  }
}
