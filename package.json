{
  "name": "parsedbf",
  "version": "2.0.0",
  "description": "The DBF parsing component of shapefile-js",
  "main": "distribution/index.js",
  "browser": "distribution/parse-dbf-browser.js",
  "type": "module",
  "scripts": {
    "prepublish": "npm run build",
    "build": "tsc",
    "test": "xo && npm run test-only",
    "test-only": "mocha -R spec test/*.ts"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/jamestalamge/parseDBF.git"
  },
  "keywords": [
    "dbf",
    "shp"
  ],
  "author": "Calvin Metcalf",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jamestalamge/parseDBF/issues"
  },
  "ava": {
    "files": [
      "test/**/*",
      "!test/data/**",
      "!test/old.test.js",
      "!test/old.typed.test.ts"
    ],
    "extensions": {
      "ts": "module"
    },
    "nodeArguments": [
      "--import=tsimp"
    ],
    "exclude": [
      "test/data"
    ]
  },
  "xo": {
    "envs": [
      "node"
    ],
    "ignores": [
      "test/data",
      "distribution",
      "decoder-old.js",
      "test/old.test.js",
      "index-old.js",
      "test/old.typed.test.ts"
    ]
  },
  "devDependencies": {
    "@sindresorhus/tsconfig": "^7.0.0",
    "@types/chai": "^5.2.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.7",
    "ava": "^6.2.0",
    "chai": "^5.2.0",
    "mocha": "^11.1.0",
    "tsimp": "^2.0.12",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "xo": "^0.60.0"
  },
  "dependencies": {
    "peek-readable": "^6.1.1"
  }
}
